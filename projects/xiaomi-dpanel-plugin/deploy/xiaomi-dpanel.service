[Unit]
Description=Xiaomi DPanel Plugin
After=network.target docker.service nginx.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/data/plugin/dpanel/current
Environment=NAS_USER_ID=__NAS_USER_ID__
Environment=DATA_DIR=/data/plugin/dpanel/data
Environment=LOCAL_ROOT=/nas/pool0/__NAS_USER_ID__/data
# 18110：原来是硬盘休眠插件已占用的那个端口（NAS 上实测由它监听），改成空闲端口。
Environment=PORT=18110
ExecStart=/usr/bin/python3 /data/plugin/dpanel/current/server.py
ExecStopPost=/usr/bin/python3 /data/plugin/dpanel/current/server.py --stop-owned
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=160M
TasksMax=32
TimeoutStopSec=40
KillMode=control-group

[Install]
WantedBy=multi-user.target
