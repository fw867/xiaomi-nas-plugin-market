[Unit]
Description=Xiaomi Transmission Docker Plugin
After=network.target docker.service nginx.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/data/plugin/transmission/current
Environment=NAS_USER_ID=__NAS_USER_ID__
Environment=DATA_DIR=/data/plugin/transmission/data
Environment=LOCAL_ROOT=/nas/pool0/__NAS_USER_ID__/data
Environment=PORT=18140
ExecStart=/usr/bin/python3 /data/plugin/transmission/current/server.py
ExecStopPost=/usr/bin/python3 /data/plugin/transmission/current/server.py --stop-owned
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=160M
TasksMax=32
TimeoutStopSec=35
KillMode=control-group

[Install]
WantedBy=multi-user.target
