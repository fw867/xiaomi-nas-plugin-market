[Unit]
Description=Xiaomi NAS Console (read-only dashboard)
Documentation=https://github.com/fw867/xiaomi-nas-plugin-market
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/data/plugin/xiaomi-nas-console/current
Environment=PYTHONUNBUFFERED=1
Environment=HOST=127.0.0.1
Environment=PORT=18100
Environment=STATIC_DIR=/data/plugin/xiaomi-nas-console/current/web
Environment=ADMIN_TOKEN_FILE=/data/plugin/xiaomi-nas-console/admin-token
Environment=SAMPLE_INTERVAL=2
Environment=HISTORY_POINTS=150
Environment=DRIVE_TTL=300
Environment=DOCKER_TTL=15
# 桌面 web 入口（唯一的写操作）：
#   LAN_TEMPLATE 是安装时留下的一份干净配置，启用时原子写回 LAN_CONF。
Environment=LAN_PORT=5001
Environment=LAN_CONF=/etc/nginx/conf.d/xiaomi-nas-console-lan.conf
Environment=LAN_TEMPLATE=/data/plugin/xiaomi-nas-console/lan/xiaomi-nas-console-lan.conf
Environment=STATE_FILE=/data/plugin/xiaomi-nas-console/state.json
ExecStart=/usr/bin/python3 /data/plugin/xiaomi-nas-console/current/server.py
Restart=on-failure
RestartSec=3

# 只读服务的最小权限：能读 /proc /sys /dev /nas /home，只允许写自己的目录
# （/etc/nginx/conf.d 是为了开关桌面入口时原子替换那一个配置文件）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/data/plugin/xiaomi-nas-console /etc/nginx/conf.d

[Install]
WantedBy=multi-user.target
