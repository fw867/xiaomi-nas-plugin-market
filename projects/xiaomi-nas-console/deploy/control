#!/bin/sh
# 小米插件规范要求的控制脚本：
# plugincenter boot 时会执行 `<plugin>/scripts/control enable`，
# 返回值非 0 会被判定为启动失败。服务的实际启停由 systemd 负责。

log() {
    logger -t "plugin" "[nasconsole] control: $*"
}

log "do $1"

case "$1" in
    enable)
        systemctl start xiaomi-nas-console.service 2>/dev/null
        ;;
    disable)
        systemctl stop xiaomi-nas-console.service 2>/dev/null
        ;;
esac

exit 0
