#!/bin/sh
# 小米插件规范要求的控制脚本：plugincenter boot 时会执行 `<plugin>/scripts/control enable`，
# 返回非 0 会被判定为插件启动失败。本插件实际的服务启停由 systemd 负责
# （xiaomi-dockerctl.service），这里只做转发并保证返回成功。
log() {
    logger -t "plugin" "[dockerctl] control: $*"
}

log "do $1"

case "$1" in
    enable)
        systemctl start xiaomi-dockerctl.service 2>/dev/null
        ;;
    disable)
        systemctl stop xiaomi-dockerctl.service 2>/dev/null
        ;;
esac

exit 0
