#!/bin/sh
# 小米插件规范要求的控制脚本：
# plugincenter boot 时会执行 `<plugin>/scripts/control enable`，
# 返回值非 0 会导致插件被判定为启动失败。
# 本插件实际的服务启停由 systemd 负责（xiaomi-webdav.service），
# 这里只做转发并保证返回成功。

log() {
    logger -t "plugin" "[webdav] control: $*"
}

log "do $1"

case "$1" in
    enable)
        systemctl start xiaomi-webdav.service 2>/dev/null
        ;;
    disable)
        systemctl stop xiaomi-webdav.service 2>/dev/null
        ;;
esac

exit 0
